/-!
# Morphir SDK for Lean 4

Lean counterparts of the functions and types in the Morphir SDK. Code generated by the Morphir Lean backend refers to
SDK members by their fully-qualified name (e.g. `Morphir.SDK.List.map`), so every SDK function used by a model needs
a definition here.

Design notes:

* Definitions are kept simple and total so that they can be unfolded in proofs.
* Elm's `Int` maps to Lean's unbounded `Int`, `Float` to `Float` (IEEE-754, not suitable for proofs) and `Decimal`
  to Lean's exact `Rat`.
* `Dict` and `Set` are represented as lists kept sorted by key, which makes structural equality coincide with
  semantic equality.
* Inside this file every reference to a Lean core function is prefixed with `_root_` because the namespaces below
  shadow the core namespaces with the same name (`List`, `String`, ...).
-/

namespace Morphir.SDK

/-- Total order on floats used where Elm treats `Float` as `comparable`. -/
instance (priority := low) floatOrd : Ord Float :=
  ⟨fun a b => if a < b then .lt else if a == b then .eq else .gt⟩

/-- Total order on rationals used where Elm treats `Decimal` as `comparable`. -/
instance (priority := low) ratOrd : Ord Rat :=
  ⟨fun a b => if a < b then .lt else if a == b then .eq else .gt⟩

/-- Operations available on Elm's `number` type class (`Int`, `Float` and `Decimal`). -/
class Number (α : Type) extends Add α, Sub α, Mul α, Neg α, Ord α where
  abs : α → α
  power : α → α → α
  ofInt : Int → α

/-- Numeric literals in code that is polymorphic over `number`. -/
instance (priority := low) [Number α] : OfNat α n := ⟨Number.ofInt n⟩

instance : Number Int where
  compare := Ord.compare
  abs x := if x < 0 then -x else x
  power b e := if e < 0 then 0 else b ^ e.toNat
  ofInt n := n

instance : Number Float where
  compare := Ord.compare
  abs := Float.abs
  power := Float.pow
  ofInt := Float.ofInt

instance : Number Rat where
  compare := Ord.compare
  abs x := if x < 0 then -x else x
  power b e := if e.den == 1 && e.num >= 0 then b ^ e.num.toNat else b
  ofInt n := n

-- Lean core does not provide equality on `Except`, which is what Elm's `Result` maps to.
deriving instance BEq, DecidableEq for Except

/-- Lexicographic order on pairs, matching Elm's comparison of tuples. -/
instance (priority := low) prodOrd [Ord α] [Ord β] : Ord (α × β) := lexOrd

namespace Basics

abbrev Int := _root_.Int
abbrev Float := _root_.Float
abbrev Bool := _root_.Bool
abbrev Order := _root_.Ordering
abbrev Never := _root_.Empty

def add [Add α] (a b : α) : α := a + b
def subtract [Sub α] (a b : α) : α := a - b
def multiply [Mul α] (a b : α) : α := a * b
def divide (a b : _root_.Float) : _root_.Float := a / b
/-- Elm's `//`: integer division truncating towards zero. -/
def integerDivide (a b : _root_.Int) : _root_.Int := _root_.Int.tdiv a b
def power [Number α] (a b : α) : α := Number.power a b
def negate [Neg α] (a : α) : α := -a
def abs [Number α] (a : α) : α := Number.abs a
/-- Elm's `modBy`: the result has the sign of the divisor. -/
def modBy (divisor x : _root_.Int) : _root_.Int := _root_.Int.fmod x divisor
/-- Elm's `remainderBy`: the result has the sign of the dividend. -/
def remainderBy (divisor x : _root_.Int) : _root_.Int := _root_.Int.tmod x divisor

def toFloat (a : _root_.Int) : _root_.Float := _root_.Float.ofInt a
def round (a : _root_.Float) : _root_.Int := (_root_.Float.round a).toInt64.toInt
def floor (a : _root_.Float) : _root_.Int := (_root_.Float.floor a).toInt64.toInt
def ceiling (a : _root_.Float) : _root_.Int := (_root_.Float.ceil a).toInt64.toInt
def truncate (a : _root_.Float) : _root_.Int := a.toInt64.toInt
def sqrt (a : _root_.Float) : _root_.Float := _root_.Float.sqrt a
def logBase (base x : _root_.Float) : _root_.Float := _root_.Float.log x / _root_.Float.log base
def e : _root_.Float := _root_.Float.exp 1
def pi : _root_.Float := 3.141592653589793
def isNaN (a : _root_.Float) : _root_.Bool := _root_.Float.isNaN a
def isInfinite (a : _root_.Float) : _root_.Bool := _root_.Float.isInf a

def equal [BEq α] (a b : α) : _root_.Bool := a == b
def notEqual [BEq α] (a b : α) : _root_.Bool := a != b
def compare [Ord α] (a b : α) : Order := Ord.compare a b
def lessThan [Ord α] (a b : α) : _root_.Bool := Ord.compare a b == .lt
def greaterThan [Ord α] (a b : α) : _root_.Bool := Ord.compare a b == .gt
def lessThanOrEqual [Ord α] (a b : α) : _root_.Bool := Ord.compare a b != .gt
def greaterThanOrEqual [Ord α] (a b : α) : _root_.Bool := Ord.compare a b != .lt
def max [Ord α] (a b : α) : α := if Ord.compare a b == .lt then b else a
def min [Ord α] (a b : α) : α := if Ord.compare a b == .gt then b else a
def clamp [Ord α] (low high x : α) : α := min high (max low x)

def not (a : _root_.Bool) : _root_.Bool := !a
def and (a b : _root_.Bool) : _root_.Bool := a && b
def or (a b : _root_.Bool) : _root_.Bool := a || b
def xor (a b : _root_.Bool) : _root_.Bool := a != b
def append [Append α] (a b : α) : α := a ++ b

def identity (a : α) : α := a
def always (a : α) (_ : β) : α := a
def composeLeft (g : β → γ) (f : α → β) : α → γ := fun x => g (f x)
def composeRight (f : α → β) (g : β → γ) : α → γ := fun x => g (f x)
def never (a : Never) : α := nomatch a

end Basics

namespace Maybe

abbrev Maybe := _root_.Option

def withDefault (default : α) (m : Option α) : α :=
  match m with
  | some v => v
  | none => default
def map (f : α → β) (m : Option α) : Option β := _root_.Option.map f m
def map2 (f : α → β → γ) (a : Option α) (b : Option β) : Option γ :=
  match a, b with
  | some x, some y => some (f x y)
  | _, _ => none
def map3 (f : α → β → γ → δ) (a : Option α) (b : Option β) (c : Option γ) : Option δ :=
  match a, b, c with
  | some x, some y, some z => some (f x y z)
  | _, _, _ => none
def map4 (f : α → β → γ → δ → ε) (a : Option α) (b : Option β) (c : Option γ) (d : Option δ) : Option ε :=
  match a, b, c, d with
  | some x, some y, some z, some w => some (f x y z w)
  | _, _, _, _ => none
def map5 (f : α → β → γ → δ → ε → ζ) (a : Option α) (b : Option β) (c : Option γ) (d : Option δ)
    (e : Option ε) : Option ζ :=
  match a, b, c, d, e with
  | some x, some y, some z, some w, some v => some (f x y z w v)
  | _, _, _, _, _ => none
def andThen (f : α → Option β) (m : Option α) : Option β := _root_.Option.bind m f
def hasValue (m : Option α) : _root_.Bool := _root_.Option.isSome m

end Maybe

namespace Result

abbrev Result := _root_.Except

def map (f : α → β) (r : Except ε α) : Except ε β :=
  match r with
  | .ok v => .ok (f v)
  | .error e => .error e
def map2 (f : α → β → γ) (a : Except ε α) (b : Except ε β) : Except ε γ :=
  match a, b with
  | .ok x, .ok y => .ok (f x y)
  | .error e, _ => .error e
  | _, .error e => .error e
def mapError (f : ε → φ) (r : Except ε α) : Except φ α :=
  match r with
  | .ok v => .ok v
  | .error e => .error (f e)
def andThen (f : α → Except ε β) (r : Except ε α) : Except ε β :=
  match r with
  | .ok v => f v
  | .error e => .error e
def withDefault (default : α) (r : Except ε α) : α :=
  match r with
  | .ok v => v
  | .error _ => default
def toMaybe (r : Except ε α) : Option α :=
  match r with
  | .ok v => some v
  | .error _ => none
def fromMaybe (err : ε) (m : Option α) : Except ε α :=
  match m with
  | some v => .ok v
  | none => .error err

end Result

namespace List

abbrev List := _root_.List

def singleton (a : α) : _root_.List α := [a]
def «repeat» (n : _root_.Int) (a : α) : _root_.List α := _root_.List.replicate n.toNat a
/-- Elm's `List.range low high`, inclusive on both ends. -/
def range (low high : _root_.Int) : _root_.List _root_.Int :=
  (_root_.List.range (high - low + 1).toNat).map (fun (i : Nat) => low + i)
def cons (a : α) (l : _root_.List α) : _root_.List α := a :: l
def map (f : α → β) (l : _root_.List α) : _root_.List β := _root_.List.map f l
def indexedMap (f : _root_.Int → α → β) (l : _root_.List α) : _root_.List β :=
  (_root_.List.zipIdx l).map (fun (a, i) => f i a)
def foldl (f : α → β → β) (init : β) (l : _root_.List α) : β :=
  _root_.List.foldl (fun acc a => f a acc) init l
def foldr (f : α → β → β) (init : β) (l : _root_.List α) : β := _root_.List.foldr f init l
def filter (p : α → _root_.Bool) (l : _root_.List α) : _root_.List α := _root_.List.filter p l
def filterMap (f : α → Option β) (l : _root_.List α) : _root_.List β := _root_.List.filterMap f l
def length (l : _root_.List α) : _root_.Int := l.length
def reverse (l : _root_.List α) : _root_.List α := _root_.List.reverse l
def member [BEq α] (a : α) (l : _root_.List α) : _root_.Bool := _root_.List.elem a l
def all (p : α → _root_.Bool) (l : _root_.List α) : _root_.Bool := _root_.List.all l p
def any (p : α → _root_.Bool) (l : _root_.List α) : _root_.Bool := _root_.List.any l p
def maximum [Ord α] (l : _root_.List α) : Option α :=
  match l with
  | [] => none
  | x :: xs => some (xs.foldl Basics.max x)
def minimum [Ord α] (l : _root_.List α) : Option α :=
  match l with
  | [] => none
  | x :: xs => some (xs.foldl Basics.min x)
def sum [Add α] [OfNat α 0] (l : _root_.List α) : α := l.foldl (· + ·) 0
def product [Mul α] [OfNat α 1] (l : _root_.List α) : α := l.foldl (· * ·) 1
def append (a b : _root_.List α) : _root_.List α := a ++ b
def concat (ls : _root_.List (_root_.List α)) : _root_.List α := _root_.List.flatten ls
def concatMap (f : α → _root_.List β) (l : _root_.List α) : _root_.List β := _root_.List.flatMap f l
def intersperse (sep : α) (l : _root_.List α) : _root_.List α := _root_.List.intersperse sep l
def map2 (f : α → β → γ) (a : _root_.List α) (b : _root_.List β) : _root_.List γ := _root_.List.zipWith f a b
def map3 (f : α → β → γ → δ) (a : _root_.List α) (b : _root_.List β) (c : _root_.List γ) : _root_.List δ :=
  _root_.List.zipWith (fun g z => g z) (_root_.List.zipWith f a b) c
def sortWith (cmp : α → α → Ordering) (l : _root_.List α) : _root_.List α :=
  _root_.List.mergeSort l (fun a b => cmp a b != .gt)
def sort [Ord α] (l : _root_.List α) : _root_.List α := sortWith Ord.compare l
def sortBy [Ord β] (f : α → β) (l : _root_.List α) : _root_.List α := sortWith (fun a b => Ord.compare (f a) (f b)) l
def isEmpty (l : _root_.List α) : _root_.Bool := _root_.List.isEmpty l
def head (l : _root_.List α) : Option α := _root_.List.head? l
def tail (l : _root_.List α) : Option (_root_.List α) :=
  match l with
  | [] => none
  | _ :: xs => some xs
def take (n : _root_.Int) (l : _root_.List α) : _root_.List α := _root_.List.take n.toNat l
def drop (n : _root_.Int) (l : _root_.List α) : _root_.List α := _root_.List.drop n.toNat l
def partition (p : α → _root_.Bool) (l : _root_.List α) : _root_.List α × _root_.List α := _root_.List.partition p l
def unzip (l : _root_.List (α × β)) : _root_.List α × _root_.List β := _root_.List.unzip l

end List

namespace Tuple

def pair (a : α) (b : β) : α × β := (a, b)
def first (t : α × β) : α := t.1
def second (t : α × β) : β := t.2
def mapFirst (f : α → γ) (t : α × β) : γ × β := (f t.1, t.2)
def mapSecond (f : β → γ) (t : α × β) : α × γ := (t.1, f t.2)
def mapBoth (f : α → γ) (g : β → δ) (t : α × β) : γ × δ := (f t.1, g t.2)

end Tuple

namespace Char

abbrev Char := _root_.Char

def isUpper (c : _root_.Char) : _root_.Bool := c.isUpper
def isLower (c : _root_.Char) : _root_.Bool := c.isLower
def isAlpha (c : _root_.Char) : _root_.Bool := c.isAlpha
def isAlphaNum (c : _root_.Char) : _root_.Bool := c.isAlphanum
def isDigit (c : _root_.Char) : _root_.Bool := c.isDigit
def toUpper (c : _root_.Char) : _root_.Char := c.toUpper
def toLower (c : _root_.Char) : _root_.Char := c.toLower
def toCode (c : _root_.Char) : _root_.Int := c.toNat
def fromCode (n : _root_.Int) : _root_.Char := _root_.Char.ofNat n.toNat

end Char

namespace String

abbrev String := _root_.String

private def isWhitespace (c : _root_.Char) : _root_.Bool := c.isWhitespace

private def isInfix (needle haystack : _root_.List _root_.Char) : _root_.Bool :=
  match haystack with
  | [] => needle.isEmpty
  | _ :: rest => needle.isPrefixOf haystack || isInfix needle rest

def isEmpty (s : _root_.String) : _root_.Bool := s.isEmpty
def length (s : _root_.String) : _root_.Int := s.length
def reverse (s : _root_.String) : _root_.String := _root_.String.ofList s.toList.reverse
def «repeat» (n : _root_.Int) (s : _root_.String) : _root_.String :=
  _root_.String.join (_root_.List.replicate n.toNat s)
def append (a b : _root_.String) : _root_.String := a ++ b
def concat (ss : _root_.List _root_.String) : _root_.String := _root_.String.join ss
def split (sep s : _root_.String) : _root_.List _root_.String := s.splitOn sep
def join (sep : _root_.String) (ss : _root_.List _root_.String) : _root_.String := sep.intercalate ss
def replace (before after s : _root_.String) : _root_.String := join after (split before s)
def left (n : _root_.Int) (s : _root_.String) : _root_.String := _root_.String.ofList (s.toList.take n.toNat)
def right (n : _root_.Int) (s : _root_.String) : _root_.String :=
  _root_.String.ofList (s.toList.drop (s.length - n.toNat))
def dropLeft (n : _root_.Int) (s : _root_.String) : _root_.String := _root_.String.ofList (s.toList.drop n.toNat)
def dropRight (n : _root_.Int) (s : _root_.String) : _root_.String :=
  _root_.String.ofList (s.toList.take (s.length - n.toNat))
def contains (needle s : _root_.String) : _root_.Bool := isInfix needle.toList s.toList
def startsWith (prefix_ s : _root_.String) : _root_.Bool := prefix_.toList.isPrefixOf s.toList
def endsWith (suffix s : _root_.String) : _root_.Bool := suffix.toList.reverse.isPrefixOf s.toList.reverse
def toInt (s : _root_.String) : Option _root_.Int := s.toInt?
def fromInt (n : _root_.Int) : _root_.String := toString n
def fromFloat (f : _root_.Float) : _root_.String := toString f
def fromChar (c : _root_.Char) : _root_.String := _root_.String.singleton c
def cons (c : _root_.Char) (s : _root_.String) : _root_.String := _root_.String.ofList (c :: s.toList)
def uncons (s : _root_.String) : Option (_root_.Char × _root_.String) :=
  match s.toList with
  | [] => none
  | c :: rest => some (c, _root_.String.ofList rest)
def toList (s : _root_.String) : _root_.List _root_.Char := s.toList
def fromList (cs : _root_.List _root_.Char) : _root_.String := _root_.String.ofList cs
def toUpper (s : _root_.String) : _root_.String := _root_.String.ofList (s.toList.map _root_.Char.toUpper)
def toLower (s : _root_.String) : _root_.String := _root_.String.ofList (s.toList.map _root_.Char.toLower)
def trimLeft (s : _root_.String) : _root_.String := _root_.String.ofList (s.toList.dropWhile isWhitespace)
def trimRight (s : _root_.String) : _root_.String :=
  _root_.String.ofList (s.toList.reverse.dropWhile isWhitespace).reverse
def trim (s : _root_.String) : _root_.String := trimRight (trimLeft s)
def words (s : _root_.String) : _root_.List _root_.String :=
  ((s.toList.splitBy (fun a b => isWhitespace a == isWhitespace b)).filter
    (fun w => !(w.all isWhitespace))).map _root_.String.ofList
def lines (s : _root_.String) : _root_.List _root_.String := s.splitOn "\n"
def padLeft (n : _root_.Int) (c : _root_.Char) (s : _root_.String) : _root_.String :=
  _root_.String.ofList (_root_.List.replicate (n.toNat - s.length) c) ++ s
def padRight (n : _root_.Int) (c : _root_.Char) (s : _root_.String) : _root_.String :=
  s ++ _root_.String.ofList (_root_.List.replicate (n.toNat - s.length) c)
def map (f : _root_.Char → _root_.Char) (s : _root_.String) : _root_.String := _root_.String.ofList (s.toList.map f)
def filter (p : _root_.Char → _root_.Bool) (s : _root_.String) : _root_.String :=
  _root_.String.ofList (s.toList.filter p)
def foldl (f : _root_.Char → β → β) (init : β) (s : _root_.String) : β :=
  s.toList.foldl (fun acc c => f c acc) init
def foldr (f : _root_.Char → β → β) (init : β) (s : _root_.String) : β := s.toList.foldr f init
def any (p : _root_.Char → _root_.Bool) (s : _root_.String) : _root_.Bool := s.toList.any p
def all (p : _root_.Char → _root_.Bool) (s : _root_.String) : _root_.Bool := s.toList.all p

end String

namespace Dict

/-- Association list kept sorted by key and free of duplicate keys. -/
structure Dict (κ : Type) (ν : Type) where
  toList : _root_.List (κ × ν)
  deriving Repr, BEq, DecidableEq

private def insertSorted [Ord κ] (k : κ) (v : ν) : _root_.List (κ × ν) → _root_.List (κ × ν)
  | [] => [(k, v)]
  | (k', v') :: rest =>
    match Ord.compare k k' with
    | .lt => (k, v) :: (k', v') :: rest
    | .eq => (k, v) :: rest
    | .gt => (k', v') :: insertSorted k v rest

def empty : Dict κ ν := ⟨[]⟩
def singleton (k : κ) (v : ν) : Dict κ ν := ⟨[(k, v)]⟩
def insert [Ord κ] (k : κ) (v : ν) (d : Dict κ ν) : Dict κ ν := ⟨insertSorted k v d.toList⟩
def remove [Ord κ] (k : κ) (d : Dict κ ν) : Dict κ ν :=
  ⟨d.toList.filter (fun (k', _) => Ord.compare k k' != .eq)⟩
def get [Ord κ] (k : κ) (d : Dict κ ν) : Option ν :=
  (d.toList.find? (fun (k', _) => Ord.compare k k' == .eq)).map Prod.snd
def member [Ord κ] (k : κ) (d : Dict κ ν) : _root_.Bool := (get k d).isSome
def update [Ord κ] (k : κ) (f : Option ν → Option ν) (d : Dict κ ν) : Dict κ ν :=
  match f (get k d) with
  | some v => insert k v d
  | none => remove k d
def isEmpty (d : Dict κ ν) : _root_.Bool := d.toList.isEmpty
def size (d : Dict κ ν) : _root_.Int := d.toList.length
def toList (d : Dict κ ν) : _root_.List (κ × ν) := d.toList
def keys (d : Dict κ ν) : _root_.List κ := d.toList.map Prod.fst
def values (d : Dict κ ν) : _root_.List ν := d.toList.map Prod.snd
def fromList [Ord κ] (l : _root_.List (κ × ν)) : Dict κ ν :=
  l.foldl (fun d (k, v) => insert k v d) empty
def map (f : κ → ν → μ) (d : Dict κ ν) : Dict κ μ := ⟨d.toList.map (fun (k, v) => (k, f k v))⟩
def foldl (f : κ → ν → β → β) (init : β) (d : Dict κ ν) : β :=
  d.toList.foldl (fun acc (k, v) => f k v acc) init
def foldr (f : κ → ν → β → β) (init : β) (d : Dict κ ν) : β :=
  d.toList.foldr (fun (k, v) acc => f k v acc) init
def filter (p : κ → ν → _root_.Bool) (d : Dict κ ν) : Dict κ ν := ⟨d.toList.filter (fun (k, v) => p k v)⟩
def partition (p : κ → ν → _root_.Bool) (d : Dict κ ν) : Dict κ ν × Dict κ ν :=
  let (a, b) := d.toList.partition (fun (k, v) => p k v)
  (⟨a⟩, ⟨b⟩)
/-- Left-biased union, like Elm's `Dict.union`. -/
def union [Ord κ] (a b : Dict κ ν) : Dict κ ν := a.toList.foldl (fun d (k, v) => insert k v d) b

end Dict

namespace Set

/-- List kept sorted and free of duplicates. -/
structure Set (α : Type) where
  toList : _root_.List α
  deriving Repr, BEq, DecidableEq

def empty : Set α := ⟨[]⟩
def singleton (a : α) : Set α := ⟨[a]⟩
def insert [Ord α] (a : α) (s : Set α) : Set α := ⟨Dict.keys (Dict.insert a () ⟨s.toList.map (·, ())⟩)⟩
def remove [Ord α] (a : α) (s : Set α) : Set α := ⟨s.toList.filter (fun b => Ord.compare a b != .eq)⟩
def member [Ord α] (a : α) (s : Set α) : _root_.Bool := s.toList.any (fun b => Ord.compare a b == .eq)
def isEmpty (s : Set α) : _root_.Bool := s.toList.isEmpty
def size (s : Set α) : _root_.Int := s.toList.length
def fromList [Ord α] (l : _root_.List α) : Set α := l.foldl (fun s a => insert a s) empty
def toList (s : Set α) : _root_.List α := s.toList
def map [Ord β] (f : α → β) (s : Set α) : Set β := fromList (s.toList.map f)
def foldl (f : α → β → β) (init : β) (s : Set α) : β := s.toList.foldl (fun acc a => f a acc) init
def foldr (f : α → β → β) (init : β) (s : Set α) : β := s.toList.foldr f init
def filter (p : α → _root_.Bool) (s : Set α) : Set α := ⟨s.toList.filter p⟩
def union [Ord α] (a b : Set α) : Set α := a.toList.foldl (fun s x => insert x s) b
def intersect [Ord α] (a b : Set α) : Set α := filter (fun x => member x b) a
def diff [Ord α] (a b : Set α) : Set α := filter (fun x => !(member x b)) a

end Set

namespace Decimal

/-- Decimals are modelled as exact rationals. See the backend documentation for the implications. -/
abbrev Decimal := Rat

def fromInt (n : _root_.Int) : Decimal := n
def add (a b : Decimal) : Decimal := a + b
def sub (a b : Decimal) : Decimal := a - b
def mul (a b : Decimal) : Decimal := a * b
def div (a b : Decimal) : Option Decimal := if b == 0 then none else some (a / b)
def divWithDefault (default a b : Decimal) : Decimal := if b == 0 then default else a / b
def negate (a : Decimal) : Decimal := -a
def abs (a : Decimal) : Decimal := if a < 0 then -a else a
def truncate (a : Decimal) : Decimal := if a < 0 then -((-a).floor : Rat) else (a.floor : Rat)
def round (a : Decimal) : Decimal := ((a + 1/2).floor : Rat)
def gt (a b : Decimal) : _root_.Bool := decide (a > b)
def gte (a b : Decimal) : _root_.Bool := decide (a ≥ b)
def lt (a b : Decimal) : _root_.Bool := decide (a < b)
def lte (a b : Decimal) : _root_.Bool := decide (a ≤ b)
def eq (a b : Decimal) : _root_.Bool := a == b
def neq (a b : Decimal) : _root_.Bool := a != b
def compare (a b : Decimal) : Ordering := Ord.compare a b
def zero : Decimal := 0
def one : Decimal := 1
def minusOne : Decimal := -1
def hundred (n : _root_.Int) : Decimal := n * 100
def thousand (n : _root_.Int) : Decimal := n * 1000
def million (n : _root_.Int) : Decimal := n * 1000000
def tenth (n : _root_.Int) : Decimal := n / 10
def hundredth (n : _root_.Int) : Decimal := n / 100
def thousandth (n : _root_.Int) : Decimal := n / 1000
def millionth (n : _root_.Int) : Decimal := n / 1000000
def bps (n : _root_.Int) : Decimal := n / 10000

end Decimal

namespace Int

abbrev Int8 := _root_.Int
abbrev Int16 := _root_.Int
abbrev Int32 := _root_.Int
abbrev Int64 := _root_.Int

end Int

