{
  "name": "morphir-elm",
  "version": "2.100.0",
  "description": "Elm bindings for Morphir",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "module": "es6",
  "types": "packages/morphir-ts/dist/",
  "main": "packages/morphir-ts/dist/index.js",
  "exports": {
    ".": "./packages/morphir-ts/dist/index.js",
    "./ir": "./packages/morphir-ts/dist/exports/ir.js",
    "./sdk": "./packages/morphir-ts/dist/exports/sdk.js",
    "./ir/*": "./packages/morphir-ts/dist/generated/morphir/ir/*.js",
    "./sdk/*": "./packages/morphir-ts/dist/sdk/*.js"
  },
  "scripts": {
    "prepare": "npm run setup-elm-tooling",
    "clean": "mise run clean",
    "test": "mise run test",
    "test-morphir-ir-typescript": "mise run test:morphir-ir",
    "insight-server-live": "cd packages/cli && elm-live src/Morphir/Web/Insight.elm --start-page=./insight.html --dir=./web --proxy-prefix /server --proxy-host http://localhost:3000/server -- --output=web/insight.js",
    "dev-server-live": "cd packages/cli && elm-live src/Morphir/Web/DevelopApp.elm --dir=web --pushstate --proxy-prefix /server --proxy-host http://localhost:3000/server -- --output=web/index.js",
    "insight-test-server-live": "cd packages/cli && elm-live src/Morphir/Web/InsightTestApp.elm --dir=web --pushstate --proxy-prefix /server --proxy-host http://localhost:3000/server -- --output=web/insight-test-app.js",
    "try-morphir-live": "cd packages/cli && elm-live src/Morphir/Web/TryMorphir.elm",
    "design-system-live": "elm-live src/Morphir/Visual/DesignSystemApp.elm",
    "multiary-decision-tree-live": "cd packages/cli && elm-live src/Morphir/Web/MultiaryDecisionTreeTest.elm --start-page=./web/treeIndex.html -- --output=treeStuff.js",
    "build": "mise run default && mise run test",
    "build:cli": "mise run build:cli",
    "build:cli2": "mise run build:cli2",
    "build:bundle": "mise run build:bundle",
    "test-coverage": "elm-coverage src/ --open",
    "build-value-editor": "elm make packages/cli/src/Morphir/Web/Editor.elm --output=packages/cli/web/valueEditor.js",
    "setup-elm-tooling": "elm-tooling install",
    "setup": "mise run setup"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finos/morphir-elm.git"
  },
  "bin": {
    "morphir-elm": "packages/cli/morphir-elm.js",
    "morphir-dapr": "packages/cli/morphir-dapr.js",
    "morphir": "cli2/lib/morphir.js",
    "morphir-mcp": "cli2/lib/morphir-mcp.js"
  },
  "engines": {
    "npm": "*",
    "node": "*"
  },
  "files": [
    "packages/cli/cli.js",
    "packages/cli/morphir-elm.js",
    "packages/cli/morphir-elm-make.js",
    "packages/cli/morphir-elm-gen.js",
    "packages/cli/morphir-elm-develop.js",
    "packages/cli/morphir-elm-test.js",
    "packages/cli/morphir-dapr.js",
    "packages/cli/Morphir.Elm.CLI.js",
    "packages/cli/Morphir.Elm.DaprCLI.js",
    "packages/cli/assets/*",
    "packages/cli/web/*",
    "dist/morphir-server/*",
    "src/Morphir/SDK/*",
    "redistributable/**",
    "cli2/lib/*",
    "cli2/Morphir.Elm.CLI.js",
    "packages/morphir-ts/dist/**"
  ],
  "keywords": [
    "morphir",
    "elm"
  ],
  "author": "MorganStanley",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Morgan-Stanley/morphir-elm/issues"
  },
  "homepage": "https://github.com/Morgan-Stanley/morphir-elm#readme",
  "devDependencies": {
    "@morphir/typespec-sdk": "file:redistributable/TypeSpec/sdk",
    "@types/bun": "latest",
    "@types/data-urls": "^3.0.4",
    "@types/inquirer": "^9.0.3",
    "@types/mocha": "^9.0.0",
    "@types/uuid": "^10.0.0",
    "@types/whatwg-encoding": "^2.0.3",
    "@typespec/compiler": "^0.59.1",
    "elm-test": "^0.19.1-revision6",
    "elm-tooling": "^1.15.0",
    "json-schema": "^0.4.0",
    "mocha": "^10.1.0",
    "package-json": "^8.1.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.0.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.1",
    "@types/d3": "^7.4.3",
    "ajv": "^8.10.0",
    "ajv-formats": "^2.1.1",
    "chalk": "^4.1.1",
    "commander": "^9.0.0",
    "cookie-parser": "^1.4.6",
    "d3": "^7.9.0",
    "data-urls": "^5.0.0",
    "dequal": "^2.0.3",
    "express": "^4.21.0",
    "fp-ts": "^2.16.10",
    "fs-extra": "^9.1.0",
    "get-stdin": "^8.0.0",
    "get-uri": "^6.0.3",
    "html-webpack-plugin": "^5.6.3",
    "immutable": "^5.0.3",
    "inquirer": "^8.0.0",
    "log-timestamp": "^0.3.0",
    "morphir-elm": "2.86.0",
    "neverthrow": "^6.2.1",
    "node-fetch": "^3.3.2",
    "packageurl-js": "^1.2.1",
    "prettier": "^2.4.1",
    "uuid": "^9.0.1",
    "vis-network": "^9.1.2",
    "whatwg-encoding": "^3.1.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "glob": "^11.0.0",
    "glob-parent": "^5.1.2",
    "package-json": "^8.1.1",
    "path-to-regexp": "^0.1.12",
    "cross-spawn": "^7.0.5"
  }
}
